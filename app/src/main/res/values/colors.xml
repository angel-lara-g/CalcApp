<?xml version="1.0" encoding="utf-8"?>

<!--
    colors.xml - Color resources for CalcApp.

    This file defines all colors used throughout the app.
    Centralizing colors here ensures visual consistency and makes
    it easy to update the color scheme from a single location.

    Usage in the app:
      - @color/black  → used as the calculator screen background in layout.xml
      - @color/white  → used as the text color for operator buttons and
                        as the backgroundTint for number buttons in layout.xml

    The remaining colors (purple, teal variants) are default colors
    generated by Android Studio and are kept here for reference,
    but are not actively used in the current layout.
-->

<resources>

    <!-- Default Material Design palette (generated by Android Studio) -->
    <color name="purple_200">#FFBB86FC</color>
    <color name="purple_500">#FF6200EE</color>
    <color name="purple_700">#FF3700B3</color>
    <color name="teal_200">#FF03DAC5</color>
    <color name="teal_700">#FF018786</color>

    <!-- Core colors actively used in the calculator layout -->

    <!-- Used as the full-screen background color of the calculator -->
    <color name="black">#FF000000</color>

    <!-- Used as button text color and number button background tint -->
    <color name="white">#FFFFFFFF</color>

</resources>
